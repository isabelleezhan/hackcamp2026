# Copy to .env.local. These values are public (they ship to the browser).

# Auth0 (Applications → your Single Page Application, and Applications → APIs).
# Domain without https://, e.g. dev-abc123.us.auth0.com
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
# The API Identifier. Must equal AUTH0_AUDIENCE in backend/.env.
VITE_AUTH0_AUDIENCE=

# FastAPI backend (Render URL once deployed).
VITE_API_URL=http://localhost:8000
