{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev",
        "--",
        "--port",
        "5173"
      ],
      "port": 5173
    },
    {
      "name": "mock-api",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "mock-api"
      ],
      "env": {
        "PORT": "8010"
      },
      "port": 8010
    },
    {
      "name": "frontend-mock",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev",
        "--",
        "--port",
        "5180"
      ],
      "env": {
        "VITE_API_URL": "http://localhost:8010"
      },
      "port": 5180
    },
    {
      "name": "frontend-phone",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev",
        "--",
        "--host",
        "0.0.0.0",
        "--port",
        "5190"
      ],
      "env": {
        "VITE_API_URL": "/api"
      },
      "port": 5190
    }
  ]
}